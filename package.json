{
  "name": "super-terminal",
  "version": "0.3.0",
  "productName": "Super Terminal",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "description": "A local home for your agent terminals.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "start:web": "node server/index.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "install:desktop": "npm run package:desktop && node scripts/install-desktop.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.64.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.2",
    "esbuild": "^0.25.0"
  }
}
